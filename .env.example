# OKX API (https://www.okx.com/account/my-api)
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# 0 = live, 1 = demo trading
OKX_FLAG=1

# Bot settings
OAT_PORT=8080
# External access: 0.0.0.0 = LAN/internet (run.bat may open Windows Firewall)
OAT_BIND_EXTERNAL=1
OAT_HOST=0.0.0.0
OAT_INITIAL_BALANCE=10000
OAT_SCAN_INTERVAL_SEC=30
OAT_MAX_POSITIONS=5
# Backtest (runs in background while server is up)
OAT_BACKTEST_AUTO_RUN=1
OAT_BACKTEST_INTERVAL_SEC=3600
OAT_BACKTEST_START_DELAY_SEC=90
OAT_BACKTEST_CANDLE_LIMIT=200
